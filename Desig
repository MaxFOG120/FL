local FLIN_LOGO_B64 = ""
local function flinB64Decode(data)
    local c = (crypt and crypt.base64decode) or (crypt and crypt.base64 and crypt.base64.decode) or base64_decode or (base64 and (base64.decode or base64.Decode))
    if c then
        local ok, res = pcall(c, data)
        if ok and type(res) == "string" and #res > 100 then return res end
    end
    local b = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local map = {}
    for i = 1, 64 do map[b:sub(i, i)] = i - 1 end
    local out, buf, bits = {}, 0, 0
    for ch in data:gmatch("[%w%+/]") do
        buf = buf * 64 + map[ch]
        bits = bits + 6
        if bits >= 8 then
            bits = bits - 8
            local byte = math.floor(buf / 2 ^ bits)
            buf = buf - byte * 2 ^ bits
            out[#out + 1] = string.char(byte)
        end
    end
    return table.concat(out)
end
local function flinLoadLogo()
    local fallback = "rbxasset://textures/ui/GuiImagePlaceholder.png"
    if not (writefile and getcustomasset) then return fallback end
    local path = "FlinHUB/Assets/logo.png"
    pcall(function()
        if makefolder then
            pcall(makefolder, "FlinHUB")
            pcall(makefolder, "FlinHUB/Assets")
        end
        if not (isfile and isfile(path)) then
            writefile(path, flinB64Decode(FLIN_LOGO_B64))
        end
    end)
    local ok, asset = pcall(getcustomasset, path)
    return ok and asset or fallback
end
