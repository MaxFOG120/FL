        copyFn = syn.write_clipboard
    end
    if type(copyFn) ~= "function" and type(clipboard) == "table" then
        copyFn = clipboard.set
    end
    if type(copyFn) ~= "function" then
        warn("[FlinHUB] Executor не поддерживает копирование в буфер обмена.")
        return
    end

    local ok, err = pcall(copyFn, invite)
    if ok then
        print("[FlinHUB] Discord-ссылка скопирована в буфер обмена.")
